# Public base URL of the existing MBSI FastAPI backend (not a GitHub repository).
# Leave unset for http://localhost:8000 ONLY on local development hosts.
# Hosted builds fall back to the deployed Render service; set this to override it.
# A checked, tab-scoped address can also be selected via Scientific backend.
VITE_MBSI_API_URL=https://mbsi-studio.onrender.com